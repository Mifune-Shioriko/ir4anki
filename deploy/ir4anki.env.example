# ir4anki — machine-local configuration
# ---------------------------------------------------------------------------
# deploy/install.sh generates ~/.config/ir4anki.env from these defaults on
# first run (it NEVER overwrites an existing file). This example documents
# every knob the backend understands.
#
# Rules:
#   - one KEY=VALUE per line, no quotes needed, no `~` (systemd does not
#     expand it — always use absolute paths)
#   - after editing: systemctl --user restart ir4anki
# ---------------------------------------------------------------------------

# ---- network --------------------------------------------------------------
# 127.0.0.1 = only this machine. Use 0.0.0.0 to reach the app from other
# devices (LAN / tailscale), e.g. a tablet on the couch.
IR4ANKI_HOST=127.0.0.1
IR4ANKI_PORT=8901

# ---- Anki -----------------------------------------------------------------
# AnkiConnect endpoint: the AnkiConnect add-on (code 2055492159) inside a
# RUNNING desktop Anki. The app drives that collection; Anki's own sync
# (AnkiWeb or a self-hosted server) moves cards between your devices.
ANKICONNECT_URL=http://127.0.0.1:8765

# collection.media of the SAME Anki profile (card images are served from
# here at /media/<file>). Linux default profile layout:
#   ~/.local/share/Anki2/<profile>/collection.media   → write the full path
ANKI_MEDIA_DIR=/home/you/.local/share/Anki2/User 1/collection.media

# Where round/quota/reading state lives (sqlite + json). Machine-local by
# design — see README "multiple machines".
ANKI_STATE_DIR=/home/you/.local/state/ir4anki

# Anki's "next day starts at" hour — must match Anki's own rollover setting
# so daily budgets reset at the same moment.
ANKI_ROLLOVER_HOUR=4

# ---- AnkiConnect traffic shaping ------------------------------------------
# Anki runs every AnkiConnect action on its main thread; back-to-back
# `sync` calls lock the collection and can make desktop Anki crawl.
# The backend therefore (a) serializes ALL AnkiConnect calls through one
# queue and (b) throttles the background sync that follows each answer:
# at most one sync per ANKI_SYNC_MIN_INTERVAL seconds — fires inside the
# cooldown window are remembered as a "tail" that runs when the window
# expires, never dropped. Round-finish / session-finish syncs are NOT
# throttled (they force an immediate sync). Set to 0 for the old
# sync-on-every-answer behaviour.
#ANKI_SYNC_MIN_INTERVAL=120

# AnkiConnect calls slower than this (ms) get a WARNING line instead of
# INFO in the log. Everything is timed and logged either way — read it
# with: journalctl --user -u ir4anki
#ANKI_SLOW_MS=2000

# ---- feature flags ----------------------------------------------------------
# Preview mode (先看后考): injected new cards land SUSPENDED in
# PREVIEW_DECK; you read + approve them, and they are unsuspended into
# RELEASE_DECK the NEXT day (first grading happens after a night of sleep,
# so FSRS seeds from real recall, not recognition).
ANKI_PREVIEW_MODE=1
ANKI_PREVIEW_DECK=预览池
ANKI_PREVIEW_RELEASE_DECK=2026
# daily cap on preview approvals (放行). Default 45 = 3 rounds × 15 preview
# (single daily pacing, 2026-09-24); <=0 disables cap + progress bar
ANKI_RELEASE_DAILY_GOAL=45

# Reading mode (渐进制卡): a markdown corpus; each listed file is dealt as
# ONE whole-file segment (2026-09-24: no pre-chunking — consume it via
# recursive bookmark splits), you write cards by hand from them. Segments,
# status and card provenance live in reading.db under ANKI_STATE_DIR.
ANKI_READING_MODE=1
ANKI_NOTES_DIR=/home/you/anki-notes

# Return "new card shown again in the same round" behaviour on Again.
ANKI_NEW_AGAIN_RETURN=1

# ---- note types used by the add-card dialogs --------------------------------
# Must match note types that EXIST in your collection.
ANKI_ADD_MODEL=问答题
ANKI_ADD_CLOZE_MODEL=填空题

# ---- pacing (optional; sensible defaults built in) --------------------------
# Single daily round shape (user spec 2026-09-24 — the old quick/focus tiers
# are retired). One 开始 button runs 阅读 → 预览新卡 → 复习 and returns to
# the start screen; no intermediate stats/pick pages. Each size below is one
# stage's per-round count:
#ANKI_DAILY_READ=4        # reading segments dealt per round
#ANKI_DAILY_PREVIEW=15    # 先看后考 preview cards per round
#ANKI_DAILY_NEW=15        # new cards mixed into the review batch
# review size is DYNAMIC: ceil(D / divisor) where D = the day's due count
# snapshotted at the first review deal (state/daily.json, Anki-day keyed), so
# 早/中/晚 three rounds clear the day's due pile evenly.
#ANKI_REVIEW_DUE_DIVISOR=3
